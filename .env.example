# Copy to .env and fill in. Brevo: SMTP & API > SMTP tab.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Connections for 'python3 -m dataload.sequences' only (the load itself always uses the confs).
# Leave empty to use ORACLE_DSN/ORACLE_USER/ORACLE_PWD and PG_DSN/PG_USER/PG_PWD from the confs.
# Format:  oracle://user:password@host:port/service_name      (port defaults to 1521)
#          postgresql://user:password@host:port/dbname         (port defaults to 5432)
# Percent-encode these characters in the user or password: @ as %40, : as %3A, / as %2F, # as %23, % as %25,
# ? as %3F. Example: password p@ss#1 is written p%40ss%231.
ORACLE_URL=
PG_URL=
